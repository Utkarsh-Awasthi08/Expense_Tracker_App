# Copy to .env (or run ./scripts/gen-secrets.sh, which does it for you with random values).
# .env is gitignored. Never commit real values.

# --- MySQL ---
MYSQL_ROOT_PASSWORD=change-me
AUTH_DB_PASSWORD=change-me
USER_DB_PASSWORD=change-me
EXPENSE_DB_PASSWORD=change-me

# --- JWT (RS256). Keys are files, mounted read-only into the containers. ---
# Generated by ./scripts/gen-secrets.sh into ./secrets/
JWT_ISSUER=expense-tracker-auth

# --- LLM (dsService) ---
# LLM_PROVIDER=mistral uses the real model (needs MISTRAL_API_KEY). LLM_PROVIDER=fake uses a
# deterministic rules-based extractor: no network call, nothing leaves your machine.
LLM_PROVIDER=mistral
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest
